// ==========================================================
// HOTELSTAY ADVANCED FEATURES TEST: advanced_control.stay
// Demonstrating MAKE, WHEN, OTHERWISE, REPEAT, and Comparisons
// ==========================================================

PRINT "=== ADVANCED CONTROL FLOW & PROGRAMMING TEST ===";

// 1. Variable Declarations & Assignments
MAKE stayDays;
MAKE discountRate;
MAKE counter;
MAKE bonusPoints;

stayDays = 5;

// 2. Conditional Statement (WHEN / OTHERWISE)
WHEN (stayDays >= 4) {
    PRINT "Long stay detected! Applying VIP 20% Discount";
    discountRate = 20;
} OTHERWISE {
    PRINT "Standard stay detected. Applying 5% Discount";
    discountRate = 5;
}

// 3. Guest Booking using computed variables
GUEST Vikram;
ROOM Vikram SUITE;
NIGHTS Vikram stayDays;
DISCOUNT Vikram discountRate;

// 4. One-time payable Gym Access (Rs. 200)
AMENITY Vikram "Gym Access" 200;

// 5. Demonstrating REPEAT Loop (Accumulating loyalty reward points)
PRINT "Calculating VIP loyalty reward points using REPEAT loop...";
counter = 1;
bonusPoints = 0;
REPEAT (counter <= 3) {
    bonusPoints = bonusPoints + 100;
    counter = counter + 1;
}
PRINT "VIP Loyalty Points earned:";
PRINT bonusPoints;

// 6. Status and Final Checkout
STATUS;
CHECKOUT Vikram;
STATUS;
